{
  "name": "@cyre/engine",
  "version": "1.0.4",
  "description": "CYRE Engine Core",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:architecture": "node scripts/audit-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "audit:placeholders": "node scripts/audit-placeholders.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false
}
