{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CYRE Studio",
  "version": "1.0.4",
  "identifier": "com.forgex4.cyre.studio",
  "build": {
    "beforeDevCommand": "pnpm --filter @cyre/studio dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @cyre/studio build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CYRE Studio \u2014 Cybersecurity Simulation Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Cybersecurity simulation editor built on the CYRE engine",
    "longDescription": "CYRE Studio is a professional editor for authoring, simulating and analysing deterministic cybersecurity scenarios on the CYRE engine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
